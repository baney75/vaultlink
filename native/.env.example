# Copy to .env, fill each blank, and chmod 600 .env. Never commit the filled file.
# Pinned multi-platform release; reviewed amd64 fixture. ARM64 is published upstream but untested here.
OBSIDIAN_IMAGE=lscr.io/linuxserver/obsidian@sha256:0ae1b2ffe772a0b4b2107f24e3462d22fa6067706d5b2f8a7cde964f855db863

# Exact paths on the Linux host. Keep config outside the vault.
VAULT_PATH=
CONFIG_PATH=

# Use `id -u` and `id -g` for the user who owns the vault.
PUID=
PGID=
TZ=Etc/UTC

# This login protects the desktop in addition to your tailnet ACL.
OBSIDIAN_USER=
OBSIDIAN_PASSWORD=
